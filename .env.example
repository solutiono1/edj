# Copy to .env and fill only what you use. See README.md for the full table.

# Optional. Email sign-in works without Google.
GOOGLE_CLIENT_ID=

# BCH payment addresses, or leave empty when using an xpub.
EDJ_RECEIVE_ADDRESS=
EDJ_TOKEN_ADDRESS=
EDJ_XPUB=
EDJ_TOKEN_XPUB=

# Payment review and transport.
EDJ_FEE_RATE=1
EDJ_ELECTRUM_HOST=
EDJ_SIGNER_ENABLED=false

# Proof signing. When EDJ_KMS_SIGN_URL is set, no local signing key is used.
EDJ_KMS_SIGN_URL=
EDJ_KMS_TOKEN=

# Production store. Without these the app uses a local JSON file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EDJ_DATA_FILE=data/edj.json

# CORS origin for the deployed API.
EDJ_PUBLIC_ORIGIN=
